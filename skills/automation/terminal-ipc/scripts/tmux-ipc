#!/bin/bash
# tmux-ipc — 終端 IPC：對具名 tmux pane 注入按鍵、回讀畫面、等待握手，全程留 md 稽核軌。
#
# 為什麼是 tmux（不是 AppleScript/Accessibility）：
#   agy「could not open TTY」、grok「Device not configured」——這些 CLI 死於沒有真 TTY。
#   tmux 提供真 TTY，且 capture-pane 能『讀回對方畫面』＝確定性狀態確認（非 LLM 猜測）。
#
# 退出碼（給 AIS tool-exec：rc==0 才算完成）：
#   0 成功 / 2 目標不存在 / 3 等待逾時 / 1 其他錯誤
#
# 環境變數：
#   TMUX_IPC_DRYRUN=1     只印出「將送出什麼」，不真的送
#   TMUX_IPC_LOGDIR       稽核軌目錄
#   TMUX_IPC_CONFIRM=1    send/type 後等到畫面指紋改變才算成功（預設 1）
#   TMUX_IPC_CONFIRM_S    確認逾時秒數（預設 5）
#   TMUX_IPC_IDLE_MS      送出前先等畫面穩定的毫秒數（預設：TUI 400 / shell 0）
#   TMUX_IPC_METHOD       auto|paste|keys（預設 auto）
#   TMUX_IPC_VERBOSE=1    診斷訊息到 stderr（不寫額外檔）
#

set -u

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOGDIR="${TMUX_IPC_LOGDIR:-$SKILL_DIR/logs}"
LOGFILE="$LOGDIR/$(date +%Y-%m-%d).md"
POLL_S="0.12"

die() { echo "[tmux-ipc] $2" >&2; exit "$1"; }
need_tmux() { command -v tmux >/dev/null || die 1 "tmux 未安裝"; }
verbose() { [ "${TMUX_IPC_VERBOSE:-0}" = "1" ] && echo "[tmux-ipc] $*" >&2 || true; }

log() {  # log <action> <target> <content>
  mkdir -p "$LOGDIR"
  [ -f "$LOGFILE" ] || printf '# terminal-ipc 稽核軌 — %s\n\n| 時間 | 動作 | 目標 | 內容 |\n|---|---|---|---|\n' \
      "$(date +%Y-%m-%d)" > "$LOGFILE"
  local c="${3-}"; c="${c//|/\\|}"; c="${c//$'\n'/  ⏎ }"
  printf '| %s | %s | %s | %s |\n' "$(date +%H:%M:%S)" "$1" "$2" "${c:0:160}" >> "$LOGFILE"
}

# ── 目標解析 ────────────────────────────────────────────────────
target_exists() {
  tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index} #{session_name}' 2>/dev/null \
    | awk '{print $1; print $2}' | grep -qx -- "$1"
}

require_target() {
  target_exists "$1" || die 2 "目標不存在：$1（用 'tmux-ipc list' 看可用目標）"
}

pane_field() { tmux display-message -p -t "$1" "$2" 2>/dev/null; }

is_tui() {
  local alt cmd
  alt="$(pane_field "$1" '#{alternate_on}')"
  cmd="$(pane_field "$1" '#{pane_current_command}')"
  [ "$alt" = "1" ] && return 0
  case "$cmd" in
    claude|codex|grok|hermes|vim|nvim|less|more|nano|emacs|lynx|w3m)
      return 0 ;;
  esac
  return 1
}

# ── 畫面 ────────────────────────────────────────────────────────
# 可見區（TUI / 握手用）。-S 歷史對 alternate screen 無效，且會把舊 shell 輸出混進來。
capture_visible() { tmux capture-pane -p -t "$1" 2>/dev/null; }

# 可見區 + 捲動歷史（shell 回讀用）
capture_hist() { tmux capture-pane -p -t "$1" -S -"${2:-40}" 2>/dev/null; }

capture_auto() {
  if is_tui "$1"; then capture_visible "$1"; else capture_hist "$1" "${2:-40}"; fi
}

last_nonempty() {
  printf '%s\n' "${1-}" | awk 'NF {line=$0} END {print line}'
}

fingerprint() {
  local vis meta
  vis="$(capture_visible "$1")"
  meta="$(pane_field "$1" '#{pane_current_command} #{cursor_x} #{cursor_y} #{alternate_on}')"
  printf '%s\n%s' "$meta" "$vis" | shasum -a 256 | awk '{print $1}'
}

looks_prompt() {
  local last
  last="$(last_nonempty "$(capture_visible "$1")")"
  case "$last" in
    *'% '|*%|*' $ '|*$|*' # '|*'❯ '*|*'❯'|*'› '*|*'> ') return 0 ;;
  esac
  return 1
}

# ── 握手（以畫面指紋為準，禁止固定 sleep 當成功條件）──────────
wait_idle_s() {
  local target="$1" idle_ms="${2:-0}" timeout_s="${3:-15}"
  [ "$idle_ms" -le 0 ] 2>/dev/null && return 0
  local start now fp last="" stable_ms=0
  start="$(date +%s)"
  last="$(fingerprint "$target")"
  while true; do
    now="$(date +%s)"
    [ $((now - start)) -ge "$timeout_s" ] && return 1
    sleep "$POLL_S"
    fp="$(fingerprint "$target")"
    if [ "$fp" = "$last" ]; then
      stable_ms=$((stable_ms + 120))
      [ "$stable_ms" -ge "$idle_ms" ] && return 0
    else
      stable_ms=0
      last="$fp"
    fi
  done
}

# 等到指紋與 old_fp 不同。成功 0，逾時 1。
wait_change() {
  local target="$1" old_fp="$2" timeout_s="${3:-5}"
  local start now fp
  start="$(date +%s)"
  while true; do
    fp="$(fingerprint "$target")"
    [ "$fp" != "$old_fp" ] && return 0
    now="$(date +%s)"
    [ $((now - start)) -ge "$timeout_s" ] && return 1
    sleep "$POLL_S"
  done
}

idle_ms_for() {
  if [ -n "${TMUX_IPC_IDLE_MS-}" ]; then
    printf '%s' "$TMUX_IPC_IDLE_MS"
  elif is_tui "$1"; then
    printf '%s' "400"
  else
    printf '%s' "0"
  fi
}

# ── 注入 ────────────────────────────────────────────────────────
# paste-buffer -p：括號貼上，TUI / 多行不會把中間的 newline 當 Enter。
# send-keys -l：字面 UTF-8，不把「C-c」當按鍵名。
inject_text() {
  local target="$1" text="$2"
  local method="${TMUX_IPC_METHOD:-auto}" buf
  if [ "$method" = "auto" ]; then
    if is_tui "$target" || printf '%s' "$text" | grep -q $'\n'; then
      method=paste
    else
      method=keys
    fi
  fi
  verbose "inject method=$method target=$target bytes=${#text}"
  case "$method" in
    paste)
      buf="ipc-$$-$RANDOM"
      printf '%s' "$text" | tmux load-buffer -b "$buf" - || return 1
      if ! tmux paste-buffer -d -p -t "$target" -b "$buf" 2>/dev/null; then
        printf '%s' "$text" | tmux load-buffer -b "$buf" - || return 1
        tmux paste-buffer -d -t "$target" -b "$buf" || return 1
      fi
      ;;
    keys)
      tmux send-keys -l -t "$target" -- "$text" || return 1
      ;;
    *) die 1 "未知 TMUX_IPC_METHOD=$method（auto|paste|keys）" ;;
  esac
}

confirm_enabled() { [ "${TMUX_IPC_CONFIRM:-1}" != "0" ]; }

# ── 子指令 ──────────────────────────────────────────────────────
cmd_list() {
  need_tmux
  tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index}  [#{pane_current_command}]  #{pane_width}x#{pane_height}  alt=#{alternate_on}' 2>/dev/null \
    || { echo "(無執行中的 tmux session)"; return 0; }
}

cmd_status() {
  need_tmux
  require_target "$1"
  local cmd alt mode dead tty pid last idle_guess
  cmd="$(pane_field "$1" '#{pane_current_command}')"
  alt="$(pane_field "$1" '#{alternate_on}')"
  mode="$(pane_field "$1" '#{pane_mode}')"
  dead="$(pane_field "$1" '#{pane_dead}')"
  tty="$(pane_field "$1" '#{pane_tty}')"
  pid="$(pane_field "$1" '#{pane_pid}')"
  last="$(last_nonempty "$(capture_visible "$1")")"
  if [ "$dead" = "1" ]; then
    idle_guess="dead"
  elif is_tui "$1"; then
    idle_guess="tui"
  elif looks_prompt "$1"; then
    idle_guess="shell-prompt"
  else
    idle_guess="busy"
  fi
  printf 'target=%s\ncommand=%s\npid=%s\ntty=%s\nalternate=%s\nmode=%s\nstate=%s\nlast=%s\n' \
    "$1" "$cmd" "$pid" "$tty" "$alt" "${mode:--}" "$idle_guess" "$last"
}

cmd_ready() {  # ready <target> [timeout_s]
  need_tmux
  local target="$1" timeout="${2:-15}" idle
  require_target "$target"
  idle="$(idle_ms_for "$target")"
  [ "$idle" -le 0 ] && idle=300
  if wait_idle_s "$target" "$idle" "$timeout"; then
    log "ready-ok" "$target" "idle_ms=$idle after ≤${timeout}s"
    echo "就緒：${target} （畫面已穩定）"
    return 0
  fi
  log "ready-timeout" "$target" "idle_ms=$idle timeout=${timeout}s"
  die 3 "等待就緒逾時（${timeout}s）：${target} 畫面仍在變動"
}

cmd_spawn() {  # spawn <name> [cmd]
  need_tmux
  local name="$1"; shift || true
  local cmd="${*:-}"
  tmux has-session -t "$name" 2>/dev/null && die 1 "session 已存在：$name"
  if [ -n "$cmd" ]; then tmux new-session -d -s "$name" "$cmd"; else tmux new-session -d -s "$name"; fi
  log "spawn" "$name" "${cmd:-<shell>}"
  echo "已建立 session：${name}${cmd:+（執行：${cmd}）}"
}

cmd_send() {  # send/type <with_enter> <target> <text...>
  need_tmux
  local with_enter="$1"; shift
  local target="$1"; shift
  local text="$*"
  require_target "$target"
  [ -n "$text" ] || die 1 "拒絕空內容：空 send/type 等於對互動程式盲按 Enter"

  if [ "${TMUX_IPC_DRYRUN:-0}" = "1" ]; then
    echo "[dry-run] -> ${target} : ${text}${with_enter:+ <Enter>}"; return 0
  fi

  local idle confirm_s fp0 action
  idle="$(idle_ms_for "$target")"
  confirm_s="${TMUX_IPC_CONFIRM_S:-5}"
  action="$([ -n "$with_enter" ] && echo send || echo type)"

  if [ "$idle" -gt 0 ]; then
    wait_idle_s "$target" "$idle" "$confirm_s" || verbose "idle wait skipped (timeout); sending anyway"
  fi

  log "before" "$target" "$(last_nonempty "$(capture_visible "$target")")"
  fp0="$(fingerprint "$target")"

  inject_text "$target" "$text" || die 1 "注入失敗：${target}"

  if confirm_enabled; then
    if ! wait_change "$target" "$fp0" "$confirm_s"; then
      log "${action}-unconfirmed" "$target" "$text"
      die 3 "注入未觀察到畫面變化（${confirm_s}s）：${target} -- 目標可能忙碌或未聚焦"
    fi
  fi

  if [ -n "$with_enter" ]; then
    local fp1
    fp1="$(fingerprint "$target")"
    tmux send-keys -t "$target" Enter
    if confirm_enabled; then
      wait_change "$target" "$fp1" "$confirm_s" || verbose "Enter 後畫面未再變（可能已在同一幀完成）"
    fi
  fi

  log "$action" "$target" "$text"
  log "after" "$target" "$(last_nonempty "$(capture_visible "$target")")"
  if confirm_enabled; then
    echo "已送出 -> ${target} （畫面已確認變化）"
  else
    echo "已送出 -> ${target}"
  fi
}

cmd_key() {  # key <target> <key...>
  need_tmux
  local target="$1"; shift
  require_target "$target"
  [ $# -ge 1 ] || die 1 "用法：key <target> <key...>"
  if [ "${TMUX_IPC_DRYRUN:-0}" = "1" ]; then echo "[dry-run] -> ${target} : key $*"; return 0; fi
  local fp0 confirm_s
  confirm_s="${TMUX_IPC_CONFIRM_S:-5}"
  fp0="$(fingerprint "$target")"
  tmux send-keys -t "$target" "$@"
  log "key" "$target" "$*"
  if confirm_enabled; then
    wait_change "$target" "$fp0" "$confirm_s" || verbose "key 後畫面未變"
  fi
  echo "已送出按鍵 -> ${target}"
}

cmd_read() {  # read <target> [lines]
  need_tmux
  require_target "$1"
  local out
  out="$(capture_auto "$1" "${2:-40}")"
  log "read" "$1" "$(last_nonempty "$out")"
  printf '%s\n' "$out"
}

cmd_wait() {  # wait <target> <pattern> [timeout_s]
  need_tmux
  local target="$1" pat="$2" timeout="${3:-60}" start now
  require_target "$target"
  [ -n "$pat" ] || die 1 "用法：wait <target> <pattern> [secs]"
  start="$(date +%s)"
  while true; do
    if capture_auto "$target" 200 | grep -q -- "$pat"; then
      now="$(date +%s)"
      log "wait-ok" "$target" "pattern=$pat after $((now - start))s"
      echo "握手成立：『${pat}』已出現（$((now - start))s）"; return 0
    fi
    now="$(date +%s)"
    [ $((now - start)) -ge "$timeout" ] && break
    sleep 1
  done
  log "wait-timeout" "$target" "pattern=$pat timeout=${timeout}s"
  die 3 "等待逾時（${timeout}s）未出現：$pat"
}

# interactive <target> <text> [interval_s] [max_checks]
# 注入後觀察畫面直到穩定（已變過且連續 2 輪不變）或達上限。
# 從未變動 → rc=3。不再固定空轉 45 秒。
cmd_interactive() {
  need_tmux
  local target="$1"; shift
  local instruction="$1"; shift || true
  local interval="${1:-2}"
  local max_checks="${2:-15}"
  require_target "$target"
  [ -n "$instruction" ] || die 1 "拒絕空內容：interactive 需要要注入的文字"
  [ "$interval" -ge 1 ] 2>/dev/null || die 1 "interval 必須是正整數秒"
  [ "$max_checks" -ge 1 ] 2>/dev/null || die 1 "max_checks 必須是正整數"

  echo "========================================================"
  echo "[tmux-ipc] 互動式閉環  target=$target  interval=${interval}s  max=$max_checks"
  echo "========================================================"
  echo "--- 執行前（可見區末 10 行）---"
  capture_visible "$target" | tail -n 10
  echo "-----------------------------------"

  if [ "${TMUX_IPC_DRYRUN:-0}" = "1" ]; then
    echo "[dry-run] -> ${target} : ${instruction} <Enter>"; return 0
  fi

  local fp0 idle confirm_s
  idle="$(idle_ms_for "$target")"
  confirm_s="${TMUX_IPC_CONFIRM_S:-5}"
  [ "$idle" -gt 0 ] && wait_idle_s "$target" "$idle" "$confirm_s" || true

  log "interactive-start" "$target" "$instruction"
  fp0="$(fingerprint "$target")"
  inject_text "$target" "$instruction" || die 1 "注入失敗：$target"
  if confirm_enabled; then
    wait_change "$target" "$fp0" "$confirm_s" || die 3 "注入未觀察到畫面變化：${target}"
  fi
  tmux send-keys -t "$target" Enter
  echo ">>> 已注入，開始觀察（畫面指紋握手，非固定 sleep）"

  local check=1 last_fp="" cur_fp="" changed=0 stable=0
  last_fp="$(fingerprint "$target")"
  [ "$last_fp" != "$fp0" ] && changed=1
  while [ "$check" -le "$max_checks" ]; do
    sleep "$interval"
    cur_fp="$(fingerprint "$target")"
    echo ""
    echo "[進度] #$check/$max_checks  耗時 $((check * interval))s"
    echo "--- 可見區末 8 行 ---"
    capture_visible "$target" | tail -n 8
    echo "----------------------"
    if [ "$cur_fp" = "$last_fp" ]; then
      echo "ℹ 畫面指紋未變"
      if [ "$changed" -eq 1 ]; then
        stable=$((stable + 1))
        if [ "$stable" -ge 2 ]; then
          log "interactive-end" "$target" "stable after ${check} cycles"
          echo "========================================================"
          echo "[tmux-ipc] 畫面已穩定，觀察結束。"
          echo "========================================================"
          return 0
        fi
      fi
    else
      echo "✓ 畫面指紋改變"
      log "interactive-update" "$target" "cycle #$check screen changed"
      changed=1
      stable=0
    fi
    last_fp="$cur_fp"
    check=$((check + 1))
  done

  if [ "$changed" -eq 0 ]; then
    log "interactive-timeout" "$target" "no change after ${max_checks} cycles"
    die 3 "觀察期間畫面從未改變：${target}"
  fi
  log "interactive-end" "$target" "still-running after ${max_checks} cycles"
  echo "========================================================"
  echo "[tmux-ipc] 已達觀察上限，畫面仍可能在執行。用 read/wait 接續。"
  echo "========================================================"
}

cmd_kill() {
  need_tmux
  require_target "$1"
  tmux kill-session -t "${1%%:*}"
  log "kill" "$1" ""
  echo "已終止：${1%%:*}"
}

cmd_scan() {
  need_tmux
  local pat="${1:-agy|codex|copilot|grok|claude|hermes|ollama|llm}"
  local map procs inlist="" outlist=""
  map="$(tmux list-panes -a -F '#{pane_tty} #{session_name}:#{window_index}.#{pane_index}' 2>/dev/null \
                    | sed 's|/dev/||')"
  procs="$(ps -eo tty=,pid=,command= 2>/dev/null | grep -Ei "$pat" | grep -v grep | grep -v 'tmux ')"

  echo "── tmux pane ──"
  tmux list-panes -a -F '   #{session_name}:#{window_index}.#{pane_index}  [#{pane_current_command}]  alt=#{alternate_on}  #{pane_tty}' 2>/dev/null \
    || echo "  （無）"
  echo

  while IFS= read -r line; do
    [ -z "$line" ] && continue
    local ptty pid pcmd tgt
    ptty="$(printf '%s' "$line" | awk '{print $1}')"
    pid="$(printf '%s' "$line" | awk '{print $2}')"
    pcmd="$(printf '%s' "$line" | awk '{$1="";$2="";print}' | sed 's/^  *//')"
    [ "$ptty" = "??" ] && continue
    tgt="$(printf '%s\n' "$map" | awk -v t="$ptty" '$1==t {print $2; exit}')"
    if [ -n "$tgt" ]; then
      inlist="${inlist}   ✅ $(printf '%-20s pid=%-6s %s' "$tgt" "$pid" "${pcmd:0:58}")"$'\n'
    else
      outlist="${outlist}   ⚠  $(printf 'tty=%-9s pid=%-6s %s' "$ptty" "$pid" "${pcmd:0:58}")"$'\n'
    fi
  done <<< "$procs"

  echo "── 可接續（已在 tmux 內）──"
  [ -n "$inlist" ] && printf '%s' "$inlist" || echo "  （無）"
  echo "── 需重啟才能控（跑在一般終端）──"
  [ -n "$outlist" ] && printf '%s' "$outlist" || echo "  （無）"
  echo
}

cmd_log() { echo "$LOGFILE"; [ -f "$LOGFILE" ] && tail -15 "$LOGFILE"; }

usage() {
  cat <<'EOF'
tmux-ipc — 終端 IPC（注入 / 回讀 / 握手 / 互動觀察）

  list                                    列出所有可用目標（session:window.pane）
  status <target>                         目標狀態：command / alternate / state / last
  ready  <target> [secs]                  等畫面穩定（TUI 必做；逾時 rc=3）
  spawn  <name> [cmd]                     建具名 session
  send   <target> <text...>               送文字 + Enter，並確認畫面變化
  type   <target> <text...>               送文字（不按 Enter），並確認畫面變化
  key    <target> <key...>                送特殊鍵（C-c / Escape / Enter）
  read   <target> [lines]                 回讀畫面（TUI＝可見區；shell＝含歷史）
  wait   <target> <pattern> [secs]        等畫面出現 pattern（逾時 rc=3）
  interactive <target> <text> [interval] [max]
                                          注入並觀察至畫面穩定；從未變動 rc=3
  scan   [pattern]                        掃描執行中的 CLI 與 pane 行程
  kill   <target>                         終止 session
  log                                     顯示稽核軌路徑與最近記錄

退出碼：0 成功（含畫面確認）/ 2 目標不存在 / 3 逾時或未觀察到變化 / 1 其他
預覽不送出：TMUX_IPC_DRYRUN=1
關閉畫面確認（舊行為）：TMUX_IPC_CONFIRM=0
EOF
}

case "${1:-}" in
  list)  shift; cmd_list "$@" ;;
  status) shift; [ $# -ge 1 ] || die 1 "用法：status <target>"; cmd_status "$@" ;;
  ready) shift; [ $# -ge 1 ] || die 1 "用法：ready <target> [secs]"; cmd_ready "$@" ;;
  spawn) shift; [ $# -ge 1 ] || die 1 "用法：spawn <name> [cmd]"; cmd_spawn "$@" ;;
  send)  shift; [ $# -ge 2 ] || die 1 "用法：send <target> <text>"; cmd_send "1" "$@" ;;
  type)  shift; [ $# -ge 2 ] || die 1 "用法：type <target> <text>"; cmd_send ""  "$@" ;;
  key)   shift; [ $# -ge 2 ] || die 1 "用法：key <target> <key>";   cmd_key "$@" ;;
  read)  shift; [ $# -ge 1 ] || die 1 "用法：read <target> [lines]"; cmd_read "$@" ;;
  wait)  shift; [ $# -ge 2 ] || die 1 "用法：wait <target> <pattern> [secs]"; cmd_wait "$@" ;;
  interactive) shift; [ $# -ge 2 ] || die 1 "用法：interactive <target> <text> [interval] [max]"; cmd_interactive "$@" ;;
  kill)  shift; [ $# -ge 1 ] || die 1 "用法：kill <target>"; cmd_kill "$@" ;;
  scan)  shift; cmd_scan "$@" ;;
  log)   cmd_log ;;
  ""|-h|--help|help) usage ;;
  *) die 1 "未知子指令：$1（--help 看用法）" ;;
esac
