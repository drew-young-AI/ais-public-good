{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/drew-young-AI/ais-public-good/schema/knowledge-record.schema.json",
  "title": "AIS knowledge record frontmatter",
  "type": "object",
  "required": [
    "id",
    "title",
    "description",
    "tags",
    "status",
    "shareable",
    "reviewed_at"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "type": {
      "type": "string",
      "enum": [
        "reference",
        "fact",
        "explanation",
        "policy",
        "decision",
        "fixture"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minItems": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "stable",
        "draft",
        "superseded"
      ]
    },
    "shareable": {
      "type": "boolean"
    },
    "reviewed_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
